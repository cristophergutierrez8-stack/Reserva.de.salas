# Django Configuration
# Generate a unique local value with Django's get_random_secret_key helper.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Database Configuration (MySQL / MariaDB or SQLite fallback)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Mail: console backend in development; configure SMTP variables for delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=reservas@example.test
